# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/facilities

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile     # check console.groq.com for current model names
GOOGLE_API_KEY=
GEMINI_MODEL=                          # optional fallback, e.g. a current Gemini Flash model

CONTACT_EMAIL=                         # sent in the User-Agent to OpenStreetMap services (required by their policy)
API_KEY=                               # shared secret between the Streamlit UI and the API

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=facility-finder-dev
